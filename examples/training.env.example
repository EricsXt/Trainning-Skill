# Copy to a private/local file and edit. This file is trusted shell code.
# Use absolute paths that exist identically on every allocated node.
TRAINING_ROOT=/shared/project
TRAIN_PYTHON=/shared/env/bin/python
TRAIN_SCRIPT=/shared/project/train.py
PLAN_PATH=/shared/project/training-plan.json
# Point to this repository on the shared filesystem.
TRAINING_SKILL_ROOT=/shared/Trainning-Skill
NNODES=2
GPUS_PER_NODE=8
# MASTER_ADDR and NODE_RANK must come from the CURRENT platform allocation.
MASTER_PORT=29500
REQUIRE_IB=true
DNS_TIMEOUT=180
# Credentials belong in platform secrets/private files, never in this example.
# Set NCCL_SOCKET_IFNAME/NCCL_IB_HCA only after checking this allocation.
# Optional OS/IB libraries must already be visible to the Python process.
